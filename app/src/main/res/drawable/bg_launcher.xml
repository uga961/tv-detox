<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07080B" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="65%p"
                android:centerX="45%"
                android:centerY="35%"
                android:startColor="#4D0C0F"
                android:centerColor="#250508"
                android:endColor="#0007080B" />
        </shape>
    </item>
</layer-list>
